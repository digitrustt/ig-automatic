# =============================================================================
# Everything below is free-tier by default. The two paid opt-ins (Anthropic,
# Apify) are commented out — the pipeline runs without them.
# =============================================================================

# --- Supabase (free tier: 500MB DB, 1GB storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: worker only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Instagram Graph API (free) ---
# Long-lived token for the Business/Creator account we publish to.
# Scopes: instagram_basic, instagram_content_publish, instagram_manage_insights, pages_show_list
IG_APP_ID=
IG_APP_SECRET=
IG_GRAPH_VERSION=v21.0

# --- Copy generation ---
# ollama   = local model, free and unmetered (default)
# template = no model at all, zero dependencies, weaker hooks
# anthropic= paid, best quality
COPY_PROVIDER=cloud
# Output language. Stated explicitly because the prompt itself is English —
# without this the model answers in English whatever the source material is.
COPY_LANGUAGE=Polish
OLLAMA_HOST=http://127.0.0.1:11434
# phi3 is small and fast; qwen2.5:7b or llama3.1:8b write noticeably better hooks.
OLLAMA_MODEL=phi3

# Only read when COPY_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# --- Optional paid discovery (Apify) ---
# Only needed for reach the Graph API does not expose. Leave unset to run free.
# APIFY_TOKEN=
# APIFY_IG_HASHTAG_ACTOR=apify~instagram-hashtag-scraper
# APIFY_IG_PROFILE_ACTOR=apify~instagram-profile-scraper

# --- Worker ---
WORKER_ID=local
WORKER_CONCURRENCY=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TMP_DIR=/tmp/ig-automatic
# TTF used to burn the hook and handle into the video. Defaults per platform;
# set explicitly if neither Arial Bold (macOS) nor DejaVu Sans Bold (Linux) exists.
FONT_PATH=

# --- YouTube clipping ---
# Path to yt-dlp; leave unset to use the one on PATH.
YTDLP_PATH=
# Netscape-format cookie file. Required only where YouTube serves a bot check
# (any datacenter address, so every CI runner). Treat it as a password: it
# grants full access to the Google account it came from — use a throwaway.
YTDLP_COOKIES_FILE=
TRANSCRIBE_LANGUAGE=pl
WHISPER_MODEL=whisper-large-v3-turbo
MAX_CLIPS_PER_VIDEO=6
# Font name libass resolves for burned-in captions.
CAPTION_FONT=DejaVu Sans

# --- Scheduling ---
# UTC hours we are willing to publish at, comma separated.
POSTING_HOURS=11,17,20

# --- Manual cron endpoints (optional; the worker schedules itself) ---
CRON_SECRET=

# Niches whose burned-in hooks stay clean. Everywhere else the hook may swear
# as freely as the clip does.
CLEAN_HOOK_NICHES=newsy
